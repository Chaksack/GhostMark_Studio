# Test artifacts
coverage/
playwright-report/
playwright-report-qa/
test-results/

# Multi-agent lane coordination notes — session scratch, not shipped docs.
coord/

# Ephemeral Playwright MCP snapshot YAMLs at the repo root — these are
# per-tool-call dumps that accumulate by the dozen on every e2e run and
# carry no diagnostic value off-session. Keep `.playwright-mcp/e2e/` and
# `.playwright-mcp/review/` (curated PNG screenshots) trackable.
.playwright-mcp/*.yml
.playwright-mcp/page-*.yml
.playwright-mcp/console-*.log

# Test fixtures the playwright MCP needs at runtime — kept out of git
# because they're regenerated by the e2e and have no review value.
.playwright-mcp/test-*.png

# Editor/agent scratch copies. These get made mid-edit and are never the
# source of truth; the file they shadow is.
*.bak
*.bak-*

# Customer-uploaded designs (real artwork in prod) — never tracked. The
# directory only exists when the dev server has accepted at least one
# storefront upload via /api/uploads/image.post.ts.
storefront/public/uploads/designs/

# Terraform
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfvars.local
