# ============================================================================
# GhostMark Studio — Medusa v2 backend environment template
#
# Copy to `.env` and fill in. Every variable here is actually read by code in
# this package (medusa-config.ts or src/**); nothing is aspirational. If you
# add a `process.env.X` read, add X here in the same commit.
#
# Generate any secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ============================================================================


# ---------------------------------------------------------------------------
# Signing secrets — REQUIRED
#
# medusa-config.ts refuses to boot in production if either is unset, shorter
# than 32 characters, or set to a well-known placeholder such as "supersecret".
# In development a random ephemeral value is generated with a loud warning,
# which logs you out on every restart until you set a real one.
#
# NEVER commit a real value. NEVER reuse the value from another environment.
# Rotating either one invalidates all existing sessions — that is expected.
# ---------------------------------------------------------------------------
JWT_SECRET=
COOKIE_SECRET=


# ---------------------------------------------------------------------------
# Database — REQUIRED
#
# WARNING: the integration test runner issues CREATE DATABASE / DROP DATABASE.
# Never point `.env.test` at a shared or production database. See `.env.test`.
# ---------------------------------------------------------------------------
DATABASE_URL=
DB_NAME=medusa-v2


# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com


# ---------------------------------------------------------------------------
# S3 file storage — REQUIRED IN PRODUCTION
#
# All five must be set together; medusa-config.ts registers the S3 file module
# only when the set is complete (a partially-configured provider would defer
# the failure to the first upload) and prints a CRITICAL warning otherwise.
#
# Without them Medusa falls back to the local-disk file provider. On an
# ephemeral filesystem (Fargate, Heroku, any rebuilt container) that means
# uploaded customer design artwork is DESTROYED ON EVERY DEPLOY, with no
# recovery path.
# ---------------------------------------------------------------------------
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
# Public base URL objects are served from (CDN or bucket endpoint), e.g.
# https://cdn.example.com or https://<bucket>.s3.<region>.amazonaws.com
S3_FILE_URL=


# ---------------------------------------------------------------------------
# Redis cache — optional, recommended in production
#
# NOTE: the variable is CACHE_REDIS_URL. Earlier versions of this template
# defined REDIS_URL, which no code read — Redis looked configured while the
# in-memory cache was silently in use. REDIS_URL is still accepted as a
# deprecated alias; prefer CACHE_REDIS_URL.
#
# Leave empty to use Medusa's in-memory cache. That cache is per-process: it is
# discarded on restart and NOT shared between instances, so with more than one
# container the instances will disagree.
# ---------------------------------------------------------------------------
CACHE_REDIS_URL=
CACHE_KEY_PREFIX=ghostmark:


# ---------------------------------------------------------------------------
# Google auth (@medusajs/auth-google)
#
# NOTE: these are the names medusa-config.ts actually reads. Earlier versions
# of this template documented GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET /
# AUTH_GOOGLE_STORE_CALLBACK_URL / AUTH_GOOGLE_ADMIN_CALLBACK_URL, none of
# which any code reads.
#
# Create credentials at https://console.cloud.google.com/apis/credentials.
# The authorized redirect URI in Google must equal AUTH_GOOGLE_CALLBACK_URL.
# ---------------------------------------------------------------------------
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# The Medusa endpoint Google redirects back to, e.g.
# http://localhost:9000/auth/customer/google/callback
AUTH_GOOGLE_CALLBACK_URL=
# Auth path the provider mounts under, e.g. /auth/customer/google
AUTH_GOOGLE_AUTH_PATH=
# Where Medusa sends the browser after auth completes. The storefront reads the
# token from the query string here.
AUTH_GOOGLE_SUCCESS_REDIRECT_URL=
AUTH_GOOGLE_FAILURE_REDIRECT_URL=


# ---------------------------------------------------------------------------
# Stripe
#
# STRIPE_WEBHOOK_SECRET was previously undocumented and unset. Without it the
# Stripe webhook handler throws on every delivery, so payments are never
# reconciled. Get it from the Stripe dashboard endpoint, or in dev from:
#   stripe listen --forward-to localhost:9000/hooks/payment/stripe
# ---------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# PayPal — optional. The provider is registered only when PAYPAL_CLIENT_ID is
# set. Sandbox mode is used automatically whenever NODE_ENV !== production.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# ShipStation fulfillment
#
# The provider is always registered so it appears in Admin. With credentials
# missing it exposes options but makes no live API calls.
# Credentials: https://shipstation.com (Settings > Account > API Settings)
# ---------------------------------------------------------------------------
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
# Optional: numeric store ID (Advanced Options > Store ID)
SHIPSTATION_STORE_ID=
# Optional: defaults to https://ssapi.shipstation.com
SHIPSTATION_BASE_URL=


# ---------------------------------------------------------------------------
# Resend email
# API key: https://resend.com/api-keys
# From address must be on a domain verified in Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com


# ---------------------------------------------------------------------------
# Notification recipients
# ---------------------------------------------------------------------------
# New support tickets and customer replies (src/api/store/support/**)
SUPPORT_ADMIN_EMAIL=support@yourdomain.com
# Order notifications (src/subscribers/order-notifications.ts). Falls back to
# GMAIL_USER_EMAIL if unset.
ADMIN_EMAIL=
GMAIL_USER_EMAIL=
# Reply-To on outbound support mail (src/api/store/support/**)
SMTP_FROM_EMAIL=
# "Send dispatch note" from the admin order documents widget.
# Falls back to SUPPORT_ADMIN_EMAIL, then INVOICE_ISSUER_EMAIL.
DISPATCH_FULFILMENT_EMAIL=


# ---------------------------------------------------------------------------
# Invoice / receipt / dispatch-note branding
# Shared by src/services/invoice-pdf.ts, receipt-pdf.ts, dispatch-note-pdf.ts
# ---------------------------------------------------------------------------
INVOICE_ISSUER_NAME=GhostMark Studio
INVOICE_ISSUER_EMAIL=
# Absolute path to a logo image file. Falls back to a sibling storefront logo.
INVOICE_LOGO_PATH=
RECEIPT_WEBSITE_URL=https://ghostmarkstudio.com
RECEIPT_PHONE_WHATSAPP=
RECEIPT_INSTAGRAM_HANDLE=


# ---------------------------------------------------------------------------
# Product reviews
# ---------------------------------------------------------------------------
# HMAC key for the one-time "leave a review" links emailed after delivery
# (src/services/review-token.ts). Falls back to MEDUSA_JWT_SECRET then
# JWT_SECRET; prefer a dedicated key so rotating one does not invalidate the
# other. Same fail-loudly rules as JWT_SECRET: production refuses to boot on a
# missing, short or placeholder value. Rotating it invalidates review links
# already emailed to customers.
REVIEW_TOKEN_SECRET=
# When "true", POST /store/products/:id/reviews requires a valid review token.
REQUIRE_REVIEW_TOKEN=
# Base URL the emailed review link points at (src/jobs/review-reminder.ts)
REVIEW_LINK_BASE_URL=
# Region code used when building review links
DEFAULT_COUNTRY_CODE=gb
# When set, the reviews endpoints require this key in the
# 'x-publishable-api-key' header. Must match the storefront's key.
MEDUSA_PUBLISHABLE_KEY=


# ---------------------------------------------------------------------------
# Gift cards (src/subscribers/gift-card-code.ts)
# ---------------------------------------------------------------------------
GIFT_CARD_CODE_PREFIX=GM
GIFT_CARD_USAGE_LIMIT=1
GIFT_CARD_SCOPE_ALL_REGIONS=true
GIFT_CARD_CAN_BE_COMBINED=false


# ---------------------------------------------------------------------------
# Public URLs
#
# KNOWN WART: the code reads several near-synonymous names for the same three
# URLs, each with its own fallback chain, because they accreted across
# subscribers/jobs/services. Set the primary of each group; the aliases exist
# only so older call sites keep resolving. Consolidating them is tracked
# separately — do not add new aliases.
# ---------------------------------------------------------------------------

# Storefront. Primary: STOREFRONT_URL.
STOREFRONT_URL=http://localhost:8000
# Aliases read by other call sites (leave empty unless a specific one differs):
STOREFRONT_BASE_URL=
STOREFRONT_PUBLIC_URL=
STORE_URL=
SITE_URL=
FRONTEND_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_STOREFRONT_URL=

# This Medusa backend. Primary: MEDUSA_BACKEND_URL.
MEDUSA_BACKEND_URL=http://localhost:9000
BACKEND_URL=

# Admin dashboard. Primary: MEDUSA_ADMIN_URL. Used to build invite links.
MEDUSA_ADMIN_URL=http://localhost:9000/app
ADMIN_PUBLIC_URL=

# Absolute base for images/links inside emails, and the logo used in email
# templates (src/services/email-template.ts). Must be publicly reachable —
# localhost URLs render as broken images in a real inbox.
EMAIL_PUBLIC_BASE_URL=
EMAIL_LOGO_URL=


# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Set to 1 to log the resolved admin Vite plugin list at boot.
GM_VITE_DEBUG=
# Honoured by the one-off maintenance scripts in src/scripts/. Set to "true"
# to preview changes without writing to the database. These scripts write to
# whatever DATABASE_URL points at — check it before running one.
DRY_RUN=true
